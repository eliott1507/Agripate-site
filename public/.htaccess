# Agripatte : configuration Apache (OVHcloud, o2switch, Hostinger, IONOS…)

ErrorDocument 404 /404.html
Options -Indexes
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse par page (évite le contenu dupliqué) :
  # 1. toujours en HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. toujours sans « www »
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. /page/index.html -> /page/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

# Compression des fichiers texte (pages plus légères, chargement plus rapide)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache navigateur. Le CSS et le JS sont versionnés (?v=empreinte) : ils peuvent être gardés un an.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # À activer une fois le HTTPS vérifié sur tout le domaine :
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
